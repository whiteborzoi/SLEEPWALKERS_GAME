// Устанавливает спрайты, позиции и шнуры(?) текстового поля


///@param sprite
///@param icon
///@param autotext icon
///@param x
///@param y
///@param text_sep
///@param text_x
///@param text_y
///@param name_x
///@param name_y
function textbox_set(argument0, argument1, argument2, argument3, argument4, argument5, argument6, argument7, argument8, argument9){
	global.textbox_sprite = argument0
	global.textbox_icon = argument1
	global.autotext_icon = argument2
	global.textbox_x = argument3
	global.textbox_y = argument4
	global.text_sep = argument5
	global.text_x = argument6
	global.text_y = argument7
	global.name_x = argument8
	global.name_y = argument9
}
